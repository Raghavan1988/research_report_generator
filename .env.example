# Copy this file to .env and fill in your values.

# OpenAI API key (used by the OpenAI client)
OPENAI_API_KEY=

# YOU.com API key
YOU_COM_API_KEY=

# OpenAI model to use for query generation and report writing (optional)
OPENAI_MODEL=gpt-4o-mini

# Port for the Flask server (optional, defaults to 5000)
PORT=5000

# Enable Flask debug mode (optional, defaults to true)
FLASK_DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL (optional, defaults to INFO)
LOG_LEVEL=INFO
